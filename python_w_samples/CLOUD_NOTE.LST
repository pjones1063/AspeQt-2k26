10 DIM U$(60), MSG$(100), R$(20)
20 U$="W:http://127.0.0.1:5000/note"
30 GRAPHICS 0 : POKE 82,0

40 PRINT "--- ATARI CLOUD NOTEPAD ---"
50 PRINT "1. READ NOTE"
60 PRINT "2. WRITE NOTE"
70 PRINT "3. EXIT"
80 PRINT "SELECT: ";
90 OPEN #1,4,0,"K:" : GET #1,K : CLOSE #1
100 PRINT CHR$(K)

110 IF K=49 THEN GOSUB 200
120 IF K=50 THEN GOSUB 300
130 IF K=51 THEN END
140 GOTO 40

200 REM --- READ ROUTINE ---
210 PRINT : PRINT "DOWNLOADING..."
220 TRAP 280
230 OPEN #2,4,1,U$
240 GET #2,C : PRINT CHR$(C); : GOTO 240

280 REM --- EOF HANDLER ---
290 CLOSE #2
300 PRINT : PRINT "--- END OF NOTE ---"
310 RETURN

300 REM --- WRITE ROUTINE ---
310 PRINT : PRINT "ENTER MESSAGE (RETURN TO SEND):"
320 INPUT MSG$
330 IF MSG$="" THEN RETURN

340 PRINT "SAVING TO CLOUD..."
350 OPEN #2,8,1,U$
360 PRINT #2;MSG$
370 CLOSE #2
380 PRINT "SAVED!"
390 RETURN

