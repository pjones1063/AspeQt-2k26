10 REM ===================================
20 REM   ASPEQT NETWORK MASTER TEST SUITE
30 REM ===================================
40 DIM U1$(40),U2$(40),U3$(40),U4$(40)
50 DIM S$(256), R$(256), PKT$(256), D$(256)
60 U1$="W1:http://10.5.5.12:5000/stress"
70 U2$="W2:http://10.5.5.12:5000/stress"
80 U3$="W3:http://10.5.5.12:5000/stress"
90 U4$="W4:http://10.5.5.12:5000/stress"
100 ERR1=0:ERR2=0:ERR3=0:ERR4=0

110 PRINT CHR$(125)
120 PRINT "=== MASTER NETWORK STRESS TEST ==="
130 PRINT "Ensure 'stress_server.py' is running."
140 PRINT "Press ANY KEY to Start..."
150 OPEN #1,4,0,"K:":GET #1,K:CLOSE #1

200 REM ===================================
210 REM TEST 1: ROUND TRIP ECHO (100 PKTS)
220 REM ===================================
230 PRINT CHR$(125):PRINT "TEST 1/4: ROUND TRIP ECHO"
240 TIME=PEEK(20)+PEEK(19)*256+PEEK(18)*65536
250 FOR I=1 TO 100
260   S$="PACKET ":S$(LEN(S$)+1)=STR$(I)
270   OPEN #1,8,0,U1$:PRINT #1;S$:CLOSE #1
280   OPEN #1,4,0,U1$:INPUT #1,R$:CLOSE #1
290   IF S$<>R$ THEN ERR1=ERR1+1:PRINT "E";
300   IF (I/10)=INT(I/10) THEN PRINT ".";
310 NEXT I
320 NOW=PEEK(20)+PEEK(19)*256+PEEK(18)*65536
330 DUR1=(NOW-TIME)/60
340 PRINT :PRINT "Done in ";DUR1;" sec. Errors: ";ERR1
350 IF ERR1>0 THEN PRINT "FAILED!":GOTO 2000
360 FOR W=1 TO 1000:NEXT W

400 REM ===================================
410 REM TEST 2: STREAMING (1-500)
420 REM ===================================
430 PRINT :PRINT "TEST 2/4: LARGE STREAM BUFFER"
440 PRINT "Writing Stream..."
450 OPEN #1,8,0,U1$
460 FOR I=1 TO 500
470   PRINT #1;I
480   IF (I/50)=INT(I/50) THEN PRINT ".";
490 NEXT I
500 CLOSE #1
510 PRINT :PRINT "Reading Stream..."
520 OPEN #1,4,0,U1$
530 FOR I=1 TO 500
540   TRAP 580
550   INPUT #1,N
560   IF N<>I THEN ERR2=ERR2+1:PRINT "E";
570   NEXT I
580 CLOSE #1:TRAP 40000
590 PRINT :PRINT "Stream Errors: ";ERR2
600 IF ERR2>0 THEN PRINT "FAILED!":GOTO 2000
610 FOR W=1 TO 1000:NEXT W

700 REM ===================================
710 REM TEST 3: QUAD CHANNEL MULTIPLEX
720 REM ===================================
730 PRINT :PRINT "TEST 3/4: 4-CHANNEL MULTIPLEX"
740 PRINT "Opening 4 Channels..."
750 OPEN #1,8,0,U1$:OPEN #2,8,0,U2$
760 OPEN #3,8,0,U3$:OPEN #4,8,0,U4$
770 PRINT "Interleaved Write..."
780 FOR I=1 TO 50
790   PRINT #1;1000+I:PRINT #2;2000+I
800   PRINT #3;3000+I:PRINT #4;4000+I
810   IF (I/10)=INT(I/10) THEN PRINT ".";
820 NEXT I
830 CLOSE #1:CLOSE #2:CLOSE #3:CLOSE #4
840 PRINT :PRINT "Parallel Read & Verify..."
850 OPEN #1,4,0,U1$:OPEN #2,4,0,U2$
860 OPEN #3,4,0,U3$:OPEN #4,4,0,U4$
870 FOR I=1 TO 50
880   TRAP 940
890   INPUT #1,N:IF N<>1000+I THEN ERR3=ERR3+1:PRINT "E1";
900   INPUT #2,N:IF N<>2000+I THEN ERR3=ERR3+1:PRINT "E2";
910   INPUT #3,N:IF N<>3000+I THEN ERR3=ERR3+1:PRINT "E3";
920   INPUT #4,N:IF N<>4000+I THEN ERR3=ERR3+1:PRINT "E4";
930 NEXT I
940 CLOSE #1:CLOSE #2:CLOSE #3:CLOSE #4:TRAP 40000
950 PRINT :PRINT "Mux Errors: ";ERR3
960 IF ERR3>0 THEN PRINT "FAILED!":GOTO 2000
970 FOR W=1 TO 1000:NEXT W

1000 REM ===================================
1010 REM TEST 4: XIO 80 MACHINE GUN
1020 REM ===================================
1030 PRINT :PRINT "TEST 4/4: XIO 80 SPEED RUN"
1040 TIME=PEEK(20)
1050 FOR I=1 TO 50
1060   PKT$="W1:":PKT$(4)=U1$
1070   PKT$(LEN(PKT$)+1)=",":PKT$(LEN(PKT$)+1)=STR$(I)
1080   XIO 80,#1,0,0,PKT$
1090   IF (I/5)=INT(I/5) THEN PRINT ".";
1100 NEXT I
1110 NOW=PEEK(20)
1120 DUR4=(NOW-TIME)/60
1130 PRINT :PRINT "50 Packets in ";DUR4;" Sec"
1140 PRINT "Speed: ";50/DUR4;" Pkts/Sec"

1200 REM ===================================
1210 REM FINAL SCOREBOARD  
1220 REM ===================================
1230 PRINT CHR$(125)
1240 PRINT "=== TEST COMPLETE ==="

1250 PRINT "1. ECHO (Reliability): ";
1260 IF ERR1=0 THEN PRINT "PASS":GOTO 1280
1270 PRINT "FAIL (";ERR1;")"

1280 PRINT "2. STREAM (Buffer):    ";
1290 IF ERR2=0 THEN PRINT "PASS":GOTO 1310
1300 PRINT "FAIL (";ERR2;")"

1310 PRINT "3. QUAD MUX (Threads): ";
1320 IF ERR3=0 THEN PRINT "PASS":GOTO 1340
1330 PRINT "FAIL (";ERR3;")"

1340 PRINT "4. XIO 80 (Speed):     ";50/DUR4;" P/S"
1350 PRINT 
1360 IF ERR1+ERR2+ERR3=0 THEN PRINT "SYSTEM STATUS: GOLD MASTER"
1370 END

2000 PRINT :PRINT "!!! CRITICAL FAILURE !!!"
2010 PRINT "Tests Aborted due to errors."
2020 END
