10 REM -- DUAL DEVICE TEST --
20 DIM U1$(40), U2$(40), D1$(20), D2$(20)
30 U1$="W1:http://127.0.0.1:5000/device1"
40 U2$="W2:http://127.0.0.1:5000/device2"

50 PRINT "1. OPENING W1..."
60 OPEN #1, 8, 1, U1$

70 PRINT "2. OPENING W2 (Concurrent)..."
80 OPEN #2, 8, 1, U2$

90 PRINT "3. WRITING TO BUFFERS..."
100 PRINT #1;"Hello from Device 1 buffer"
110 PRINT #2;"Greetings from Device 2 buffer"

120 PRINT "4. CLOSING W2 (SENDING)..."
130 CLOSE #2

140 PRINT "5. CLOSING W1 (SENDING)..."
150 CLOSE #1

160 PRINT "DONE."



10 REM -- XIO 44 TEST --
20 DIM U$(60), MSG$(40), CMD$(100)
30 U$="W:http://127.0.0.1:5000/trigger"
40 MSG$=",Hello from XIO 44!"

50 REM -- CONCATENATE STRINGS --
60 CMD$=U$
70 CMD$(LEN(CMD$)+1)=MSG$

80 PRINT "SENDING: ";CMD$
90 XIO 44,#1,0,1,CMD$
100 PRINT "DONE."
