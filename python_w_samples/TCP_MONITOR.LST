10 DIM DAT$(15), C$(3), R$(3), D$(3), BAR$(20), SPC$(20)
15 BAR$="====================": SPC$="                    "
20 GRAPHICS 0: POKE 752,1: PRINT CHR$(125): REM HIDE CURSOR & CLEAR
30 POSITION 6,2: PRINT "DEBIAN PRODUCTION DASHBOARD"
40 POSITION 2,5: PRINT "CPU [                    ]"
50 POSITION 2,7: PRINT "RAM [                    ]"
60 POSITION 2,9: PRINT "DSK [                    ]"

70 TRAP 320: REM CATCH NETWORK DROPS
80 POSITION 2,12: PRINT "CONNECTING TO 10.5.5.3..."
90 OPEN #1,12,1,"W:TCP://10.5.5.3:9090"
100 POSITION 2,12: PRINT "STREAMING LIVE TELEMETRY...  "

110 REM --- MAIN TELEMETRY LOOP ---
115 PRINT #1;"PING" : REM TRIGGERS THE REFILL HACK!
120 INPUT #1, DAT$
130 IF LEN(DAT$)<11 THEN 115 : REM IGNORE GARBAGE

140 REM --- PARSE THE FIXED-LENGTH STRING ---
150 C$=DAT$(1,3): CPU=VAL(C$)
160 R$=DAT$(5,7): RAM=VAL(R$)
170 D$=DAT$(9,11): DSK=VAL(D$)

180 REM --- UPDATE CPU BAR ---
190 POSITION 28,5: PRINT C$;"%"
200 L=INT(CPU/5): POSITION 7,5
210 IF L=0 THEN PRINT SPC$; : GOTO 240
220 IF L=20 THEN PRINT BAR$; : GOTO 240
230 PRINT BAR$(1,L);SPC$(1,20-L);

240 REM --- UPDATE RAM BAR ---
250 POSITION 28,7: PRINT R$;"%"
260 L=INT(RAM/5): POSITION 7,7
270 IF L=0 THEN PRINT SPC$; : GOTO 300
280 IF L=20 THEN PRINT BAR$; : GOTO 300
290 PRINT BAR$(1,L);SPC$(1,20-L);

300 REM --- UPDATE DSK BAR ---
310 POSITION 28,9: PRINT D$;"%"
320 L=INT(DSK/5): POSITION 7,9
330 IF L=0 THEN PRINT SPC$; : GOTO 360
340 IF L=20 THEN PRINT BAR$; : GOTO 360
350 PRINT BAR$(1,L);SPC$(1,20-L);

360 GOTO 115

370 REM --- ERROR HANDLER ---
380 POSITION 2,14: PRINT "NETWORK DISCONNECTED. ERR: ";PEEK(195)
390 CLOSE #1
400 END
