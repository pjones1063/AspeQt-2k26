10 DIM U$(50), T$(100), R$(20)
20 U$="W:http://127.0.0.1:5000/speak"
30 GRAPHICS 0 : POKE 82,0

40 PRINT "--- THE TALKING ATARI ---"
50 PRINT "TYPE A PHRASE:"
60 INPUT T$
70 IF T$="" THEN GOTO 60

80 PRINT "SENDING SPEECH..."

90 REM --- SEND TEXT TO PC (POST) ---
100 OPEN #1,8,1,U$
110 PRINT #1;T$
120 CLOSE #1

130 REM --- CHECK STATUS (GET) ---
140 OPEN #1,4,1,U$
150 INPUT #1,R$
160 CLOSE #1

170 PRINT "STATUS: ";R$
180 PRINT : GOTO 50

