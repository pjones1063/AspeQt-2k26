10 DIM U$(60), CMD$(20), R$(40), IP$(25)
20 IP$="127.0.0.1:5000"
30 GRAPHICS 0 : POKE 82,0

40 PRINT "--- DEBIAN CONTROLLER ---"
50 PRINT "1. OPEN CALCULATOR"
60 PRINT "2. OPEN EDITOR"
70 PRINT "3. SEND POPUP MSG"
80 PRINT "-----------------------"
90 PRINT "SELECT (1-3): ";

100 OPEN #1,4,0,"K:" : GET #1,K : CLOSE #1
110 PRINT CHR$(K)

120 IF K=49 THEN CMD$="calc"
130 IF K=50 THEN CMD$="editor"
140 IF K=51 THEN CMD$="hello"
150 IF CMD$="" THEN GOTO 90

160 REM --- CONSTRUCT URL ---
170 U$="W:http://"
180 U$(LEN(U$)+1)=IP$
190 U$(LEN(U$)+1)="/cmd/"
200 U$(LEN(U$)+1)=CMD$
210 PRINT "SENDING..."

220 TRAP 270
230 OPEN #1,4,0,U$
240 INPUT #1,R$
250 PRINT "LINUX SAYS: ";R$
260 CLOSE #1
270 PRINT : GOTO 40

280 REM --- ERROR HANDLER ---
290 PRINT "TIMEOUT OR ERROR!"
300 CLOSE #1
310 GOTO 40
