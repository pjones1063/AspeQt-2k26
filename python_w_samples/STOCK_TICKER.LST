10 DIM U$(60), F$(100), D$(120), TICKER$(10)
20 U$="W1:http://127.0.0.1:5000/stock/"

100 PRINT CHR$(125)
110 PRINT "--- ATARI WALL STREET ---"
120 PRINT "ENTER TICKER SYMBOL"
130 PRINT "(E.G. AAPL, MSFT, GME)"
140 PRINT 
150 PRINT "SYMBOL: ";
160 INPUT TICKER$

170 IF LEN(TICKER$)=0 THEN 100
180 IF TICKER$="EXIT" THEN END

500 REM -- NETWORK FETCH ROUTINE --
510 PRINT 
520 PRINT "CONTACTING BROKER..."
530 F$=U$
540 F$(LEN(F$)+1)=TICKER$

550 REM -- OPEN CONNECTION --
560 TRAP 700
570 OPEN #1, 4, 1, F$

600 REM -- READ RESPONSE --
610 INPUT #1, D$
620 PRINT CHR$(125); : REM CLEAR SCREEN FOR DRAMA
630 PRINT "--- LATEST QUOTE ---"
640 PRINT 
650 PRINT D$
660 PRINT 
670 CLOSE #1
680 PRINT "PRESS RETURN FOR MENU...";:INPUT D$
690 GOTO 100

700 REM -- ERROR HANDLER --
710 PRINT "CONNECTION ERROR!"
720 CLOSE #1
730 PRINT "PRESS RETURN...";:INPUT D$
740 GOTO 100