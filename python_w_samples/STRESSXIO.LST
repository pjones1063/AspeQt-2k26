10 DIM U$(60), MSG$(100), PKT$(200)
20 U$="http://10.5.5.12:5000/stress"

30 PRINT CHR$(125)
40 PRINT "--- XIO 80 (ONE-SHOT POST) ---"
50 PRINT "TARGET: ";U$
60 PRINT 

70 REM -- GET USER INPUT --
80 PRINT "ENTER MESSAGE TO SEND:"
90 INPUT MSG$

100 REM -- BUILD PACKET "W1:URL,DATA" --
110 PKT$="W1:"
120 PKT$(4)=U$
130 PKT$(LEN(PKT$)+1)=","
140 PKT$(LEN(PKT$)+1)=MSG$

150 PRINT 
160 PRINT "SENDING VIA COMMAND 80..."

170 REM -- EXECUTE XIO 80 --
180 REM -- XIO cmd, #ch, aux1, aux2, "device:file" --
190 TRAP 230
200 XIO 80,#1,0,0,PKT$
210 PRINT "SUCCESS! MESSAGE SENT."
220 GOTO 60

230 REM -- ERROR HANDLER --
240 PRINT "ERROR CODE: ";PEEK(195)
250 GOTO 60

