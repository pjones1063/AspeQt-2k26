*** Test 1 ****
10 REM -- ROUND TRIP ECHO TEST --
20 DIM U$(40), S$(50), R$(50)
30 U$="W1:http://127.0.0.1:5000/stress"

40 PRINT "STARTING 100 ROUND TRIPS..."
50 ERR=0
60 TIME=PEEK(20)+PEEK(19)*256+PEEK(18)*65536

70 FOR I=1 TO 100
80   REM -- 1. PREPARE DATA --
90   S$="PACKET "
100  S$(LEN(S$)+1)=STR$(I)
110  
120  REM -- 2. WRITE PHASE (POST) --
130  OPEN #1, 8, 0, U$
140  PRINT #1;S$
150  CLOSE #1
160  
170  REM -- 3. READ PHASE (GET) --
180  OPEN #1, 4, 0, U$
190  INPUT #1,R$
200  CLOSE #1
210  
220  REM -- 4. VERIFY --
230  IF S$<>R$ THEN PRINT "ERR: ";S$;" <> ";R$:ERR=ERR+1
240  PRINT ".";
250 NEXT I

260 NOW=PEEK(20)+PEEK(19)*256+PEEK(18)*65536
270 DUR=(NOW-TIME)/60
280 PRINT 
290 PRINT "DONE. TIME: ";DUR;" SEC"
300 PRINT "ERRORS: ";ERR


** Test 2 ***
5 REM -- BIG STREAMING TEST --
10 DIM U$(60)
20 U$="W1:http://10.5.5.12:5000/stress"

30 PRINT CHR$(125)
40 PRINT "--- STREAMING DATA TEST ---"

50 REM -- STEP 1: WRITE STREAM --
60 PRINT "OPENING WRITE STREAM..."
70 OPEN #1, 8, 0, U$
80 PRINT "SENDING 1-500..."
90 FOR I=1 TO 500
100   PRINT #1;I
110   IF (I/50)=INT(I/50) THEN PRINT ".";
120 NEXT I
130 CLOSE #1
140 PRINT :PRINT "UPLOAD COMPLETE."

150 REM -- STEP 2: READ STREAM --
160 PRINT "OPENING READ STREAM..."
170 OPEN #1, 4, 0, U$
180 PRINT "VERIFYING..."
190 ERR=0
200 FOR I=1 TO 500
210   TRAP 260
220   INPUT #1,N
230   IF N<>I THEN PRINT "ERR: GOT ";N;" EXP ";I:ERR=ERR+1
240   IF (I/50)=INT(I/50) THEN PRINT ".";
250 NEXT I

260 CLOSE #1
270 TRAP 40000
280 PRINT :PRINT "DONE."
290 PRINT "TOTAL ERRORS: ";ERR


*** Test 3 ***
5 REM  4-WAY MULTIPLEX TEST
10 DIM U1$(40),U2$(40),U3$(40),U4$(40)
20 U1$="W1:http://10.5.5.12:5000/stress"
30 U2$="W2:http://10.5.5.12:5000/stress"
40 U3$="W3:http://10.5.5.12:5000/stress"
50 U4$="W4:http://10.5.5.12:5000/stress"

60 PRINT CHR$(125)
70 PRINT "--- QUAD CHANNEL STRESS TEST ---"

80 REM -- STEP 1: PARALLEL OPEN WRITE --
90 PRINT "OPENING 4 WRITERS..."
100 OPEN #1,8,0,U1$
110 OPEN #2,8,0,U2$
120 OPEN #3,8,0,U3$
130 OPEN #4,8,0,U4$

140 REM -- STEP 2: INTERLEAVED WRITE --
150 PRINT "WRITING INTERLEAVED DATA..."
160 FOR I=1 TO 50
170   REM -- CHANNEL 1: 1000 series --
180   PRINT #1;1000+I
190   REM -- CHANNEL 2: 2000 series --
200   PRINT #2;2000+I
210   REM -- CHANNEL 3: 3000 series --
220   PRINT #3;3000+I
230   REM -- CHANNEL 4: 4000 series --
240   PRINT #4;4000+I
250   IF (I/10)=INT(I/10) THEN PRINT ".";
260 NEXT I

270 REM -- STEP 3: CLOSE ALL --
280 PRINT :PRINT "CLOSING & POSTING..."
290 CLOSE #1:CLOSE #2:CLOSE #3:CLOSE #4

300 REM -- STEP 4: PARALLEL READ --
310 PRINT "OPENING 4 READERS..."
320 OPEN #1,4,0,U1$
330 OPEN #2,4,0,U2$
340 OPEN #3,4,0,U3$
350 OPEN #4,4,0,U4$

360 REM -- STEP 5: VERIFY STREAMS --
370 PRINT "VERIFYING DATA INTEGRITY..."
380 ERR=0
390 FOR I=1 TO 50
400   TRAP 600
410   INPUT #1,N1: IF N1<>1000+I THEN ERR=ERR+1:PRINT "E1";
420   INPUT #2,N2: IF N2<>2000+I THEN ERR=ERR+1:PRINT "E2";
430   INPUT #3,N3: IF N3<>3000+I THEN ERR=ERR+1:PRINT "E3";
440   INPUT #4,N4: IF N4<>4000+I THEN ERR=ERR+1:PRINT "E4";
450   IF (I/10)=INT(I/10) THEN PRINT ".";
460 NEXT I

500 PRINT :PRINT "CLOSING..."
510 CLOSE #1:CLOSE #2:CLOSE #3:CLOSE #4
520 PRINT "TOTAL ERRORS: ";ERR
530 IF ERR=0 THEN PRINT "SUCCESS: 4-WAY MULTIPLEX PERFECT!"
540 END

600 PRINT "TRAP ERROR: ";PEEK(195)
610 GOTO 500


*** Test 4 *** 
5 REM XIO HAMMER TEST
10 DIM U$(60), PKT$(256), D$(200)
20 U$="http://10.5.5.12:5000/stress"

30 PRINT CHR$(125)
40 PRINT "--- XIO 80 STRESS TEST ---"

50 REM ===================================
60 REM TEST 1: SPEED RUN (50 PACKETS)
70 REM ===================================
80 PRINT "TEST 1: FIRE 50 PACKETS..."
90 T1=PEEK(20)
100 FOR I=1 TO 50
110   REM -- BUILD "W1:URL,DATA" --
120   PKT$="W1:"
130   PKT$(4)=U$
140   PKT$(LEN(PKT$)+1)=","
150   PKT$(LEN(PKT$)+1)=STR$(I)
160   REM -- FIRE AND FORGET --
170   XIO 80,#1,0,0,PKT$
180   IF (I/5)=INT(I/5) THEN PRINT ".";
190 NEXT I
200 T2=PEEK(20)
210 DUR=(T2-T1)/60
220 PRINT :PRINT "TIME: ";DUR;" SECONDS"
230 PRINT "AVG SPEED: ";50/DUR;" PKT/SEC"

240 REM ===================================
250 REM TEST 2: PAYLOAD SIZE (LARGE DATA)
260 REM ===================================
270 PRINT :PRINT "TEST 2: INCREASING PAYLOAD..."
280 D$="DATA"
290 FOR I=1 TO 10
300   REM -- DOUBLE THE DATA LENGTH --
310   D$(LEN(D$)+1)=D$
320   IF LEN(D$)>100 THEN D$=D$(1,100): GOTO 340
330 NEXT I
340 PRINT "SENDING 100 BYTE PAYLOAD..."
350 PKT$="W1:":PKT$(4)=U$
360 PKT$(LEN(PKT$)+1)=",":PKT$(LEN(PKT$)+1)=D$
370 XIO 80,#1,0,0,PKT$
380 PRINT "SUCCESS (NO CRASH)."

390 REM ===================================
400 REM TEST 3: CHANNEL HOPPING (W1/W2)
410 REM ===================================
420 PRINT :PRINT "TEST 3: W1/W2 SWAPPING..."
430 FOR I=1 TO 20
440   REM -- SEND TO W1 ($57) --
450   PKT$="W1:":PKT$(4)=U$:PKT$(LEN(PKT$)+1)=",W1-PING"
460   XIO 80,#1,0,0,PKT$
470   REM -- SEND TO W2 ($56) --
480   PKT$="W2:":PKT$(4)=U$:PKT$(LEN(PKT$)+1)=",W2-PING"
490   XIO 80,#1,0,0,PKT$
500   PRINT ".";
510 NEXT I

520 PRINT :PRINT "ALL TESTS COMPLETE."



