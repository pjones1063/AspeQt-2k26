10 DIM U$(40), A$(120), B$(250)
20 U$="W:http://127.0.0.1:5000/chat"
30 GRAPHICS 0 : PRINT "--- GEMINI AI (NO HISTORY) ---"

40 REM --- 1. GET USER INPUT ---
50 PRINT ">"; : INPUT A$
60 IF A$="" THEN GOTO 50

70 REM --- 2. SEND TO PYTHON (POST) ---
80 OPEN #1,8,1,U$
90 PRINT #1;A$
100 CLOSE #1

110 REM --- 3. GET REPLY (GET) ---
120 PRINT "Thinking..."
130 OPEN #1,4,1,U$
140 INPUT #1,B$
150 CLOSE #1

160 REM --- 4. PRINT RESPONSE ---
170 PRINT B$
180 PRINT : GOTO 40
