10 DIM U$(60), F$(100), D$(120), CMD$(20)
20 U$="W1:http://10.5.5.12:5000"

100 PRINT CHR$(125)
110 PRINT "--- ATARI SMART PORTAL ---"
120 PRINT "1. CHECK WEATHER"
130 PRINT "2. CHECK SERVER TIME"
140 PRINT "3. EXIT"
150 PRINT "SELECT: ";:INPUT OPT

160 IF OPT=1 THEN CMD$="/weather":GOTO 500
170 IF OPT=2 THEN CMD$="/time":GOTO 500
180 IF OPT=3 THEN END
190 GOTO 100

500 REM -- NETWORK FETCH ROUTINE --
510 PRINT "FETCHING..."
520 F$=U$
530 F$(LEN(F$)+1)=CMD$

540 REM -- OPEN WITH FULL URL --
550 OPEN #1, 4, 0, F$

600 TRAP 650
610 INPUT #1, D$
620 PRINT 
630 PRINT D$
640 CLOSE #1
650 TRAP 40000
660 PRINT "PRESS RETURN...";:INPUT D$
670 GOTO 100
