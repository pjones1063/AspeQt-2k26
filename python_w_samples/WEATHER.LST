10 DIM U$(50), T$(20), D$(40)
20 U$="W:http://127.0.0.1:5000/weather"

30 REM --- SETUP GRAPHICS 5 (4 COLORS) ---
40 GRAPHICS 5
50 SETCOLOR 0,2,8 : REM COLOR 1 (ORANGE)
60 SETCOLOR 1,0,10 : REM COLOR 2 (GREY/WHITE)
70 SETCOLOR 2,8,6 : REM COLOR 3 (BLUE)
80 SETCOLOR 4,0,0 : REM BACKGROUND (BLACK)

90 PRINT "FETCHING WEATHER..."

100 REM --- GET DATA FROM PYTHON ---
110 OPEN #1,4,0,U$
120 INPUT #1,ID
130 INPUT #1,T$
140 INPUT #1,D$
150 CLOSE #1

160 REM --- CLEAR SCREEN & DRAW ---
170 PRINT CHR$(125) : REM CLEAR TEXT WINDOW
180 IF ID=1 THEN GOSUB 1000 : REM SUN
190 IF ID=2 THEN GOSUB 2000 : REM CLOUD
200 IF ID=3 THEN GOSUB 3000 : REM RAIN
210 IF ID=4 THEN GOSUB 4000 : REM SNOW

220 REM --- PRINT TEXT STATUS ---
230 POKE 656,1 : REM TEXT WINDOW CURSOR FIX
240 PRINT : PRINT "TEMP: ";T$
250 PRINT D$
260 END

1000 REM --- DRAW SUN (ID 1) ---
1010 COLOR 1
1020 PLOT 35,10 : DRAWTO 45,10
1030 DRAWTO 50,20 : DRAWTO 45,30
1040 DRAWTO 35,30 : DRAWTO 30,20
1050 DRAWTO 35,10
1060 REM RAYS
1070 PLOT 40,5 : DRAWTO 40,2
1080 PLOT 40,35 : DRAWTO 40,38
1090 PLOT 25,20 : DRAWTO 22,20
1100 PLOT 55,20 : DRAWTO 58,20
1110 RETURN

2000 REM --- DRAW CLOUD (ID 2) ---
2010 COLOR 2
2020 PLOT 20,20 : DRAWTO 60,20
2030 DRAWTO 60,15 : DRAWTO 50,10
2040 DRAWTO 30,10 : DRAWTO 20,15
2050 DRAWTO 20,20
2060 REM FILL
2070 PLOT 30,15 : DRAWTO 50,15
2080 RETURN

3000 REM --- DRAW RAIN (ID 3) ---
3010 GOSUB 2000 : REM DRAW CLOUD FIRST
3020 COLOR 3
3030 PLOT 25,25 : DRAWTO 23,30
3040 PLOT 35,25 : DRAWTO 33,30
3050 PLOT 45,25 : DRAWTO 43,30
3060 PLOT 55,25 : DRAWTO 53,30
3070 RETURN

4000 REM --- DRAW SNOW (ID 4) ---
4010 GOSUB 2000 : REM DRAW CLOUD FIRST
4020 COLOR 2
4030 PLOT 25,28 : PLOT 35,32
4040 PLOT 45,28 : PLOT 55,32
4050 PLOT 30,35 : PLOT 50,35
4060 RETURN
