10 DIM U$(60), CMD$(20), R$(40)
20 IP$="127.0.0.1:5000"
30 GRAPHICS 0 : POKE 82,0

40 PRINT "--- ATARI PC CONTROLLER ---"
50 PRINT "1. OPEN CALCULATOR"
60 PRINT "2. OPEN NOTEPAD"
70 PRINT "3. SEND 'HELLO' POPUP"
80 PRINT "-----------------------"
90 PRINT "SELECT (1-3): ";

100 OPEN #1,4,0,"K:" : GET #1,K : CLOSE #1
110 PRINT CHR$(K)

120 IF K=49 THEN CMD$="calc"
130 IF K=50 THEN CMD$="notepad"
140 IF K=51 THEN CMD$="hello"
150 IF CMD$="" THEN GOTO 90

160 REM --- SEND COMMAND ---
170 U$="W:http://" : U$(12)=IP$ : U$(LEN(U$)+1)="/cmd/" : U$(LEN(U$)+1)=CMD$
180 PRINT "SENDING: ";U$

190 TRAP 250
200 OPEN #1,4,1,U$
210 INPUT #1,R$
220 PRINT "PC SAYS: ";R$
230 CLOSE #1
240 PRINT : GOTO 40

250 REM --- ERROR HANDLER ---
260 PRINT "ERROR OR TIMEOUT!"
270 CLOSE #1
280 GOTO 40

