10 DIM URL$(100), R$(255)
20 GRAPHICS 0: PRINT "--- FTP DOWNLOAD TEST ---"
30 URL$="W:FTP://10.5.5.3/test_file.txt"
40 PRINT "FETCHING: ";URL$
50 PRINT "WAITING FOR ASPEQT TO DOWNLOAD..."
60 TRAP 140 : REM CATCH THE EOF
70 REM OPEN MODE 4 (READ), AUX2=1 (TEXT TRANSLATION)
80 OPEN #1,4,1,URL$
90 PRINT "DOWNLOADED! READING FROM BUFFER:"
100 PRINT "---------------------------------"
110 INPUT #1,R$
120 PRINT R$
130 GOTO 110
140 REM --- ERROR & EOF HANDLER ---
150 ERR=PEEK(195)
160 IF ERR=136 THEN PRINT "---------------------------------":PRINT "SUCCESS! END OF FILE.":GOTO 180
170 PRINT "--- NETWORK ERROR ";ERR;" ---"
180 CLOSE #1
190 END
