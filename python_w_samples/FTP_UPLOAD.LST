10 DIM URL$(100)
20 GRAPHICS 0: PRINT "--- FTP UPLOAD TEST ---"
30 REM MUST INCLUDE FILENAME IN THE URL!
40 URL$="W:FTP://10.5.5.3/atari_upload.txt"
50 PRINT "UPLOADING TO: ";URL$
60 TRAP 130
70 REM OPEN MODE 8 (WRITE), AUX2=1 (TEXT TRANSLATION)
80 OPEN #1,8,1,URL$
90 PRINT "WRITING DATA TO ASPEQT BUFFER..."
100 PRINT #1;"HELLO FROM ATARI BASIC!"
110 PRINT #1;"THIS FILE WAS UPLOADED OVER THE SIO BUS."
120 PRINT "SENDING TO FTP SERVER..."
130 CLOSE #1 : REM THIS TRIGGERS THE ACTUAL NETWORK UPLOAD!
140 PRINT "UPLOAD COMPLETE."
150 END
160 PRINT "--- NETWORK ERROR ";PEEK(195);" ---"
170 CLOSE #1
180 END

