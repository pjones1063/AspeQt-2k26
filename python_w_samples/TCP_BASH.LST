10 DIM CMD$(255),RESP$(255)
20 GRAPHICS 0:PRINT "CONNECTING TO DEBIAN TCP..."
30 TRAP 200:REM CATCH NETWORK FAILURES
40 REM OPEN IN MODE 12 (R/W) WITH AUX2=1 (TEXT MODE)
50 OPEN #1,12,1,"W:TCP://10.5.5.3:9090"
60 REM --- READ THE WELCOME BANNER ---
70 INPUT #1,RESP$
80 PRINT RESP$
90 REM --- MAIN SHELL LOOP ---
100 PRINT "BASH> ";:INPUT CMD$
110 IF CMD$="EXIT" THEN PRINT #1;"EXIT":GOTO 240
120 IF CMD$="" THEN 100
130 REM SEND COMMAND (NATIVE 6502 FLUSH ON RETURN)
140 PRINT #1;CMD$
150 REM --- READ RESPONSE LOOP ---
160 TRAP 200:REM RESET TRAP EVERY LOOP
170 INPUT #1,RESP$
180 IF RESP$="===EOF===" THEN 100
190 PRINT RESP$:GOTO 160
200 REM --- ERROR HANDLING ---
210 ERR=PEEK(195)
220 IF ERR=136 THEN PRINT "CONNECTION CLOSED.":GOTO 240
230 PRINT "--- NETWORK ERROR ";ERR;" ---"
240 CLOSE #1
250 PRINT "DISCONNECTED."
260 END

