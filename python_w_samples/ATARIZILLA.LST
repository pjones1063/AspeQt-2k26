100 REM *** ATARIZILLA 5.0 (DOS 2.5 UI) ***
110 DIM P$(100), T$(100), F$(30), N$(30), A$(128), C$(1)
115 DIM H$(50), U$(30), PW$(30), L$(30), D$(40)

120 PRINT CHR$(125);"=== ATARIZILLA SETUP ==="
130 PRINT "HOST (IP:PORT): ";:INPUT H$
140 PRINT "USERNAME: ";:INPUT U$
150 PRINT "PASSWORD: ";:INPUT PW$
160 PRINT "CONNECTING TO HOST..."
170 P$="W:SFTP://":P$(LEN(P$)+1)=U$:P$(LEN(P$)+1)=":"
180 P$(LEN(P$)+1)=PW$:P$(LEN(P$)+1)="@":P$(LEN(P$)+1)=H$
185 P$(LEN(P$)+1)="/" : REM DEFAULT TO ROOT DIRECTORY
190 XIO 41,#1,0,0,P$

200 REM --- DRAW DOS 2.5 STYLE MENU ---
210 PRINT CHR$(125): REM CLEAR SCREEN
220 PRINT "ATARIZILLA NETWORK DOS   VERSION 5.0"
230 PRINT "COPYRIGHT 2026 ASPEQT-2K26 PROJECT"
240 PRINT 
250 PRINT "A. LIST DIRECTORY   E. DELETE FILE"
260 PRINT "B. CHANGE DIR (CD)  F. DOWNLOAD FILE"
270 PRINT "C. VIEW TEXT FILE   G. UPLOAD FILE"
280 PRINT "D. RENAME FILE      H. QUIT TO BASIC"
290 PRINT 

300 REM --- DUP.SYS STYLE LOOP ---
310 PRINT 
320 PRINT "SELECT ITEM OR ";CHR$(27);"RETURN";CHR$(27);" FOR MENU"
330 TRAP 210 : INPUT C$ : TRAP 40000
335 IF C$= "" THEN GOTO 210
340 IF C$="A" OR C$="a" THEN GOSUB 1000
350 IF C$="B" OR C$="b" THEN GOSUB 2000
360 IF C$="C" OR C$="c" THEN GOSUB 3000
370 IF C$="D" OR C$="d" THEN GOSUB 4000
380 IF C$="E" OR C$="e" THEN GOSUB 5000
390 IF C$="F" OR C$="f" THEN GOSUB 6000
400 IF C$="G" OR C$="g" THEN GOSUB 7000
410 IF C$="H" OR C$="h" THEN PRINT "GOODBYE.":END
420 GOTO 310

1000 REM --- LIST DIRECTORY ---
1010 PRINT CHR$(125):PRINT "FILTER (* FOR ALL, RETURN TO MENU):"
1015 F$="": TRAP 1110
1020 INPUT F$: TRAP 40000
1025 IF F$="" THEN RETURN
1030 T$="W:":T$(LEN(T$)+1)=F$
1040 PRINT "FETCHING DIR..."
1050 TRAP 1100
1060 OPEN #1,6,1,T$
1070 INPUT #1,A$:PRINT A$
1080 GOTO 1070
1100 CLOSE #1:TRAP 40000
1110 PRINT "- END OF DIR -":RETURN

2000 REM --- CHANGE DIRECTORY (XIO 41) ---
2010 PRINT "ENTER DIR ('..' TO GO UP, RETURN TO MENU):"
2015 F$="": TRAP 2080
2020 INPUT F$: TRAP 40000
2025 IF F$="" THEN RETURN
2030 T$="W:":T$(LEN(T$)+1)=F$
2040 TRAP 2080
2050 XIO 41,#1,0,0,T$
2060 PRINT "DIRECTORY CHANGED!"
2070 TRAP 40000:RETURN
2080 PRINT "ERROR CHANGING DIR.":TRAP 40000:RETURN

3000 REM --- VIEW TEXT FILE ---
3010 PRINT "FILENAME (RETURN TO MENU):"
3015 F$="": TRAP 3090
3020 INPUT F$: TRAP 40000
3025 IF F$="" THEN RETURN
3030 T$="W:":T$(LEN(T$)+1)=F$
3040 PRINT "DOWNLOADING..."
3050 TRAP 3090 : REM <--- THIS WAS THE TYPO
3060 OPEN #1,4,1,T$
3070 INPUT #1,A$:PRINT A$
3080 GOTO 3070
3090 CLOSE #1:TRAP 40000
3100 PRINT "- END OF FILE -":RETURN

4000 REM --- RENAME FILE (XIO 32) ---
4010 PRINT "OLD FILENAME (RETURN TO MENU):"
4012 F$="": TRAP 4100
4015 INPUT F$: TRAP 40000
4018 IF F$="" THEN RETURN
4020 PRINT "NEW FILENAME:"
4022 N$="": TRAP 4100
4025 INPUT N$: TRAP 40000
4028 IF N$="" THEN RETURN
4030 T$="W:":T$(LEN(T$)+1)=F$
4040 T$(LEN(T$)+1)=",":T$(LEN(T$)+1)=N$
4050 PRINT "RENAMING..."
4060 TRAP 4100
4070 XIO 32,#1,0,0,T$
4080 PRINT "RENAME SUCCESSFUL!"
4090 TRAP 40000:RETURN
4100 PRINT "ERROR RENAMING FILE.":TRAP 40000:RETURN

5000 REM --- DELETE FILE (XIO 33) ---
5010 PRINT "FILENAME (RETURN TO MENU):"
5015 F$="": TRAP 5080
5020 INPUT F$: TRAP 40000
5025 IF F$="" THEN RETURN
5030 T$="W:":T$(LEN(T$)+1)=F$
5040 PRINT "DELETING..."
5050 TRAP 5080
5060 XIO 33,#1,0,0,T$
5070 PRINT "DELETE SUCCESSFUL!"
5080 TRAP 40000:RETURN
5090 PRINT "ERROR DELETING FILE.":TRAP 40000:RETURN

6000 REM --- DOWNLOAD FILE (W: TO D:) ---
6010 PRINT "REMOTE FILENAME (RETURN TO MENU):"
6012 F$="": TRAP 6140
6015 INPUT F$: TRAP 40000
6018 IF F$="" THEN RETURN
6020 PRINT "LOCAL SAVENAME (D:):"
6022 L$="": TRAP 6140
6025 INPUT L$: TRAP 40000
6028 IF L$="" THEN RETURN
6030 T$="W:":T$(LEN(T$)+1)=F$
6040 D$="D:":D$(LEN(D$)+1)=L$
6050 PRINT "DOWNLOADING (BINARY)..."
6060 TRAP 6110
6070 OPEN #1,4,2,T$ : REM W: Read, Binary Mode
6080 OPEN #2,8,0,D$ : REM D: Write Mode
6090 GET #1,B:PUT #2,B
6100 GOTO 6090
6110 CLOSE #1:CLOSE #2
6120 TRAP 40000
6130 PRINT "DOWNLOAD COMPLETE!"
6140 RETURN

7000 REM --- UPLOAD FILE (D: TO W:) ---
7010 PRINT "LOCAL FILENAME (D:) (RETURN TO MENU):"
7012 L$="": TRAP 7140
7015 INPUT L$: TRAP 40000
7018 IF L$="" THEN RETURN
7020 PRINT "REMOTE SAVENAME (RETURN FOR SAME):"
7022 F$="": TRAP 7140
7025 INPUT F$: TRAP 40000
7028 IF F$="" THEN F$=L$
7030 D$="D:":D$(LEN(D$)+1)=L$
7040 T$="W:":T$(LEN(T$)+1)=F$
7050 PRINT "UPLOADING (BINARY)..."
7060 TRAP 7110
7070 OPEN #1,4,0,D$ : REM D: Read Mode
7080 OPEN #2,8,2,T$ : REM W: Write, Binary Mode
7090 GET #1,B:PUT #2,B
7100 GOTO 7090
7110 CLOSE #1:CLOSE #2
7120 TRAP 40000
7130 PRINT "UPLOAD COMPLETE!"
7140 RETURN

