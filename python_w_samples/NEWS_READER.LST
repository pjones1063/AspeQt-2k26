10 DIM U$(60), F$(100), D$(120), CAT$(10)
20 U$="W1:http://192.168.x.x:5000/news/"

100 PRINT CHR$(125)
110 PRINT "--- ATARI TELETYPE ---"
120 PRINT "1. WORLD NEWS (BBC)"
130 PRINT "2. TECH NEWS"
140 PRINT "3. NASA SPACE NEWS"
150 PRINT "4. PYTHON UPDATES"
160 PRINT "5. EXIT"
170 PRINT 
180 PRINT "SELECT FEED: ";:INPUT OPT

190 IF OPT=1 THEN CAT$="TOP"
200 IF OPT=2 THEN CAT$="TECH"
210 IF OPT=3 THEN CAT$="SPACE"
220 IF OPT=4 THEN CAT$="PY"
230 IF OPT=5 THEN END

500 REM -- FETCH ROUTINE --
510 PRINT CHR$(125); "CONNECTING TO WIRE SERVICE..."
520 F$=U$
530 F$(LEN(F$)+1)=CAT$

540 REM -- OPEN CONNECTION --
550 TRAP 700
560 OPEN #1, 4, 1, F$

600 REM -- READ LOOP --
610 REM * READ UNTIL ERROR 136 (EOF) *
620 TRAP 680
630 INPUT #1, D$
640 PRINT D$
650 PRINT "---------------------------------------"
660 GOTO 630

680 REM -- END OF FEED --
690 CLOSE #1
700 PRINT 
710 PRINT "PRESS RETURN FOR MENU...";:INPUT D$
720 GOTO 100

800 REM -- CONNECTION ERROR --
810 PRINT "ERR: WIRE DOWN (CONNECTION FAILED)"
820 GOTO 700