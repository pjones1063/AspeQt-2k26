    52 				; =================================================================
    53 				; 1. OPEN ROUTINES (The only part that differs significantly)
    54 				; =================================================================
    55
    56 				; --- OPEN Y: (CLIPBOARD) ---
    57 4021			HandlerOpenY
    58 4021 A9 59		    lda #$59        ; 'Y'
    59 4023 8D 03 40		    sta CurrentDev  ; Remember who we are
    60 				    
    61 4026 20 95 40		    jsr CommonReset ; Reset Pointers
    62 				    
    63 				    ; Setup SIO for Y: (Standard Open, No Data)
    64 4029 20 3E 41		    jsr SetupDCB_Open
    65 				    
    66 				    ; Check Mode (Read/Write)
    67 402C A5 2A		    lda $2A         ; ICAX1
    68 402E 8D 0A 03		    sta DAUX1
    69 4031 29 08		    and #$08
    70 4033 D0 0B		    bne DoOpenY
    71 				    
    72 				    ; Read Mode -> Refill Immediately
    73 4035 20 59 E4		    jsr SIOV
    74 4038 30 54		    bmi OpenFail
    75 403A 20 19 41		    jsr RefillBuffer
    76 403D 4C 87 40		    jmp OpenSuccess
    77
    78 4040			DoOpenY
    79 4040 20 59 E4		    jsr SIOV
    80 4043 30 49		    bmi OpenFail
    81 4045 4C 87 40		    jmp OpenSuccess
    82
    83
    84 				; --- OPEN W: (WWW Pipe) ---
    85 4048			HandlerOpenW
    86 4048 A9 57		    lda #$57        ; 'W'
    87 404A 8D 03 40		    sta CurrentDev
    88 				    
    89 404D 20 95 40		    jsr CommonReset
    90
    91 				    ; 1. Base Setup
    92 4050 20 3E 41		    jsr SetupDCB_Open
    93 4053 A5 2A		    lda $2A         ; Load ICAX1 (4=Read, 8=Write, 12=Update)
    94 4055 8D 0A 03		    sta DAUX1
    95 				    
    96 				    ; 2. N: Specifics - WE MUST SEND THE URL!
    97 				    ; The URL pointer is in ICBAL/H ($0344/5)
    98 4058 8E 02 40		    stx SaveX
    99 405B AE 02 40		    ldx SaveX
   100 405E BD 44 03		    lda $0344,x     ; ICBAL
   101 4061 8D 04 03		    sta DBUFLO
   102 4064 BD 45 03		    lda $0345,x     ; ICBAH
   103 4067 8D 05 03		    sta DBUFHI
   104 				    
   105 				    ; 3. Force Write Mode (Sending URL to PC)
   106 406A A9 80		    lda #$80        ; Write Direction
   107 406C 8D 03 03		    sta DSTATS
   108 406F A9 00		    lda #$00
   109 4071 8D 08 03		    sta DBYTLO
   110 4074 A9 01		    lda #$01        ; Length 256
   111 4076 8D 09 03		    sta DBYTHI
   112 				    
   113 				    
   114 				    ; 4. Send the Open Command
   115 4079 20 59 E4		    jsr SIOV
   116 407C 30 10		    bmi OpenFail
   117 				    
   118 				    ; 5. If we are in READ mode, fill buffer now
   119 407E A5 2A		    lda $2A         ; ICAX1
   120 4080 29 08		    and #$08
   121 4082 D0 03		    bne OpenSuccess
   122 4084 20 19 41		    jsr RefillBuffer
   123
   124 4087			OpenSuccess
   125 4087 AE 02 40		    ldx SaveX
   126 408A A0 01		    ldy #1
   127 408C 18			    clc
   128 408D 60			    rts
   129
   130 408E			OpenFail
   131 408E AE 02 40		    ldx SaveX
   132 4091 A0 90		    ldy #144
   133 4093 38			    sec
   134 4094 60			    rts
   135
   136 4095			CommonReset
   137 4095 A9 00		    lda #0
   138 4097 8D 00 40		    sta BufPtr
   139 409A 8D 01 40		    sta EOF_Flag
   140 409D 60			    rts
   141
   142 				; =================================================================
   143 				; 2. SHARED ROUTINES (Get/Put/Close work for BOTH!)
   144 				; =================================================================
   145 				; Note: These routines use 'CurrentDev' to know which device ID to send
   146
   147 409E			HandlerGet
   148 409E 8E 02 40		    stx SaveX
   149 				    
   150 				    ; 1. Check EOF
   151 40A1 AD 01 40		    lda EOF_Flag
   152 40A4 F0 04		    beq FetchByte
   153 40A6 A0 88		    ldy #136        ; EOF Error
   154 40A8 38			    sec             
   155 40A9 60			    rts
   156
   157 40AA			FetchByte
   158 40AA AE 00 40		    ldx BufPtr
   159 40AD BD 00 06		    lda IOBuf,x
   160 				    
   161 				    ; --- NULL CHECK ---
   162 40B0 C9 00		    cmp #0
   163 40B2 F0 11		    beq FoundNull
   164
   165 				    ; --- INCREMENT & CHECK REFILL ---
   166 40B4 EE 00 40		    inc BufPtr
   167 40B7 D0 05		    bne GetDone
   168
   169 				    ; -- REFILL NEEDED --
   170 40B9 48			    pha
   171 40BA 20 19 41		    jsr RefillBuffer
   172 40BD 68			    pla
   173 				    
   174 40BE			GetDone
   175 40BE AE 02 40		    ldx SaveX
   176 40C1 A0 01		    ldy #1
   177 40C3 18			    clc
   178 40C4 60			    rts
   179
   180 40C5			FoundNull
   181 40C5 A9 01		    lda #1
   182 40C7 8D 01 40		    sta EOF_Flag
   183 40CA AE 02 40		    ldx SaveX
   184 40CD A0 88		    ldy #136
   185 40CF 38			    sec
   186 40D0 60			    rts
   187
   188 40D1			HandlerPut
   189 40D1 8E 02 40		    stx SaveX
   190 				    
   191 				    ; 1. Store Byte
   192 40D4 AE 00 40		    ldx BufPtr
   193 40D7 9D 00 06		    sta IOBuf,x
   194 				    
   195 				    ; 2. Increment & Check Full
   196 40DA EE 00 40		    inc BufPtr
   197 40DD D0 07		    bne PutSuccess
   198 				    
   199 				    ; 3. Buffer Full -> FLUSH
   200 40DF 20 2C 41		    jsr FlushBuffer
   201 40E2 C0 01		    cpy #1
   202 40E4 D0 07		    bne PutError
   203 				    
   204 40E6			PutSuccess
   205 40E6 AE 02 40		    ldx SaveX
   206 40E9 A0 01		    ldy #1
   207 40EB 18			    clc
   208 40EC 60			    rts
   209
   210 40ED			PutError
   211 40ED AE 02 40		    ldx SaveX
   212 40F0 38			    sec
   213 40F1 60			    rts
   214
   215 40F2			HandlerClose
   216 40F2 A5 2A		    lda $2A
   217 40F4 29 08		    and #$08
   218 40F6 D0 04		    bne CloseWrite
   219 40F8 A0 01		    ldy #1
   220 40FA 18			    clc
   221 40FB 60			    rts
   222
   223 40FC			CloseWrite
   224 40FC 8E 02 40		    stx SaveX
   225 40FF AD 00 40		    lda BufPtr
   226 4102 F0 0E		    beq CloseCommit
   227 				    
   228 				    ; Pad Loop
   229 4104 AE 00 40		    ldx BufPtr
   230 4107			PadLoop
   231 4107 A9 00		    lda #0
   232 4109 9D 00 06		    sta IOBuf,x
   233 410C E8			    inx
   234 410D D0 F8		    bne PadLoop
   235 				    
   236 410F 20 2C 41		    jsr FlushBuffer
   237
   238 4112			CloseCommit
   239 				    ; Send 'C' Command
   240 4112 20 74 41		    jsr SetupDCB_Close
   241 				    
   242 4115 A0 01		    ldy #1
   243 4117 18			    clc
   244 4118 60			    rts
   245
   246 				; =================================================================
   247 				; 3. SHARED HELPERS
   248 				; =================================================================
   249 4119			RefillBuffer
   250 4119 20 80 41		    jsr SetupDCB_Read
   251 411C 10 06		    bpl RefillOK
   252 				    
   253 411E A9 01		    lda #1
   254 4120 8D 01 40		    sta EOF_Flag
   255 4123 60			    rts
   256 4124			RefillOK
   257 4124 A9 00		    lda #0
   258 4126 8D 00 40		    sta BufPtr
   259 4129 A0 01		    ldy #1
   260 412B 60			    rts
   261
   262 412C			FlushBuffer
   263 412C 20 96 41		    jsr SetupDCB_Write
   264 412F 10 01		    bpl FlushOK
   265 4131 60			    rts             ; Error in Y
   266 4132			FlushOK
   267 4132 A9 00		    lda #0
   268 4134 8D 00 40		    sta BufPtr
   269 4137 A0 01		    ldy #1
   270 4139 60			    rts
   271
   272 413A			HandlerStat
   273 413A			HandlerSpec
   274 413A A0 01		    ldy #1
   275 413C 18			    clc
   276 413D 60			    rts
   277
   278 				; =================================================================
   279 				; 4. SIO SETUP (Uses CurrentDev)
   280 				; =================================================================
   281 413E			SetupDCB_Open
   282 413E A9 4F		    lda #$4F        ; Cmd 'O'
   283 4140 8D 02 03		    sta DCOMND
   284 4143 A9 00		    lda #0
   285 4145 8D 03 03		    sta DSTATS
   286 4148 A9 00		    lda #<IOBuf
   287 414A 8D 04 03		    sta DBUFLO
   288 414D A9 06		    lda #>IOBuf
   289 414F 8D 05 03		    sta DBUFHI
   290 4152 A9 08		    lda #$08        ; Timeout
   291 4154 8D 06 03		    sta DTIMLO
   292 4157 A9 00		    lda #0
   293 4159 8D 08 03		    sta DBYTLO
   294 415C 8D 0A 03		    sta DAUX1
   295 415F 8D 0B 03		    sta DAUX2
   296 4162 8D 07 03		    sta DUNUSE
   297 4165 A9 01		    lda #1
   298 4167 8D 09 03		    sta DBYTHI      ; Length 256
   299 416A 8D 01 03		    sta DUNIT
   300 				    
   301 416D AD 03 40		    lda CurrentDev  ; <--- MAGIC: Uses $59 or $4E
   302 4170 8D 00 03		    sta DDEVIC
   303 4173 60			    rts
   304
   305 4174			SetupDCB_Close
   306 4174 20 3E 41		    jsr SetupDCB_Open
   307 4177 A9 43		    lda #$43        ; Cmd 'C'
   308 4179 8D 02 03		    sta DCOMND
   309 417C 20 59 E4		    jsr SIOV
   310 417F 60			    rts
   311
   312 4180			SetupDCB_Read
   313 4180 20 3E 41		    jsr SetupDCB_Open ; Reuse base init
   314 4183 A9 52		    lda #$52        ; Cmd 'R'
   315 4185 8D 02 03		    sta DCOMND
   316 4188 A9 40		    lda #$40        ; Read
   317 418A 8D 03 03		    sta DSTATS
   318 418D A9 04		    lda #$04        ; Faster Read Timeout
   319 418F 8D 06 03		    sta DTIMLO
   320 4192 20 59 E4		    jsr SIOV
   321 4195 60			    rts
   322
   323 4196			SetupDCB_Write
   324 4196 20 3E 41		    jsr SetupDCB_Open ; Reuse base init
   325 4199 A9 57		    lda #$57        ; Cmd 'W'
   326 419B 8D 02 03		    sta DCOMND
   327 419E A9 80		    lda #$80        ; Write
   328 41A0 8D 03 03		    sta DSTATS
   329 41A3 A9 0A		    lda #$0A        ; Write Timeout
   330 41A5 8D 06 03		    sta DTIMLO
   331 41A8 20 59 E4		    jsr SIOV
   332 41AB 60			    rts
   333
   334 				; =================================================================
   335 				; 5. THE RESET TRAP (The "Immortal" Logic)
   336 				; =================================================================
   337 41AC			OnReset
   338 				    ; This routine runs AUTOMATICALLY every time System Reset is pressed.
   339 				    
   340 				    ; 1. Re-Protect Memory (The most important part!)
   341 41AC A9 29		    lda #<EndHandler
   342 41AE 8D E7 02		    sta $02E7        ; MEMLO Low
   343 41B1 A9 42		    lda #>EndHandler
   344 41B3 8D E8 02		    sta $02E8        ; MEMLO High
   345 				    
   346 				    ; 2. Re-Install Handlers (Just in case OS wiped HATABS)
   347 41B6 20 DC 41		    jsr InitHandlersOnly 
   348 				    
   349 				    ; 3. Return control to the real DOS (Chain the hook)
   350 41B9 6C 04 40		    jmp (OldDOSINI)
   351 				    
   352 				    
   353 				; =================================================================
   354 				; INSTALLER 
   355 				; =================================================================
   356 41BC			Init
   357 				    ; 1. Install Handlers initially
   358 41BC 20 DC 41		    jsr InitHandlersOnly
   359 				    
   360 				    ; 2. Set MEMLO initially
   361 41BF A9 29		    lda #<EndHandler
   362 41C1 8D E7 02		    sta $02E7
   363 41C4 A9 42		    lda #>EndHandler
   364 41C6 8D E8 02		    sta $02E8
   365 				    
   366 				    ; 3. HOOK THE RESET VECTOR (DOSINI)
   367 				    ; Save the old vector first!
   368 41C9 A5 0C		    lda $0C
   369 41CB 8D 04 40		    sta OldDOSINI
   370 41CE A5 0D		    lda $0D
   371 41D0 8D 05 40		    sta OldDOSINI+1
   372 				    
   373 				    ; Point DOSINI to our 'OnReset' routine
   374 41D3 A9 AC		    lda #<OnReset
   375 41D5 85 0C		    sta $0C
   376 41D7 A9 41		    lda #>OnReset
   377 41D9 85 0D		    sta $0D
   378 				    
   379 41DB 60			    rts
   380
   381 				; --- Helper to avoid code duplication ---
   382 41DC			InitHandlersOnly
   383 				    ; --- Install Y ($59) ---
   384 41DC A9 59		    lda #$59
   385 41DE A2 09		    ldx #<TableY
   386 41E0 A0 40		    ldy #>TableY
   387 41E2 20 F9 41		    jsr InstallOne
   388 				    
   389 				    ; --- Install W ($57) ---
   390 41E5 A9 57		    lda #$57
   391 41E7 A2 15		    ldx #<TableW
   392 41E9 A0 40		    ldy #>TableW
   393 41EB 20 F9 41		    jsr InstallOne
   394 				    
   395 				    ; Fix MEMLO once
   396 41EE A9 00		    lda #$00
   397 41F0 8D E7 02		    sta $02E7
   398 41F3 A9 42		    lda #$42
   399 41F5 8D E8 02		    sta $02E8
   400 41F8 60			    rts
   401
   402 41F9			InstallOne
   403 41F9 8D 06 40		    sta DeviceID
   404 41FC 8E 07 40		    stx TableLo
   405 41FF 8C 08 40		    sty TableHi
   406 				    
   407 4202 A2 00		    ldx #0
   408 4204			FindSlot
   409 4204 BD 1A 03		    lda HATABS,x
   410 4207 F0 0D		    beq FoundEmpty
   411 4209 CD 06 40		    cmp DeviceID
   412 420C F0 08		    beq FoundEmpty ; Overwrite if exists
   413 420E E8			    inx
   414 420F E8			    inx
   415 4210 E8			    inx
   416 4211 E0 21		    cpx #33
   417 4213 90 EF		    bcc FindSlot
   418 4215 60			    rts
   419 4216			FoundEmpty
   420 4216 AD 06 40		    lda DeviceID
   421 4219 9D 1A 03		    sta HATABS,x
   422 421C AD 07 40		    lda TableLo
   423 421F 9D 1B 03		    sta HATABS+1,x
   424 4222 AD 08 40		    lda TableHi
   425 4225 9D 1C 03		    sta HATABS+2,x
   426 4228 60			    rts
   427
   428 4229			EndHandler
   429 02E0-02E1> BC 41		    run Init
