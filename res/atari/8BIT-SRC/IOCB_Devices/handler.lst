    10 				; =================================================================
    11 				; RESIDENT DATA (Page 6 - Safe from BASIC)
    12 				; =================================================================
    13 				    org $0600    
    14 = 0600			IOBuf       .ds 256  ; Shared Buffer (Safe because SIO is blocking)
    15
    16 				; =================================================================
    17 				; RESIDENT CODE
    18 				; =================================================================
    19 				    org $4000
    20 				    .align 256 
    21
    22 				; --- VARIABLES ---
    23 FFFF> 4000-4228> 00	BufPtr      .byte 0 
    24 4001 00			EOF_Flag    .byte 0 
    25 4002 00			SaveX       .byte 0
    26 4003 00			CurrentDev  .byte 0  
    27 4004 00 00		OldDOSINI   .word 0
    28 				; Temp storage for installer
    29 4006 00			DeviceID    .byte 0
    30 4007 00			TableLo     .byte 0
    31 4008 00			TableHi     .byte 0
    32
    33 				; =================================================================
    34 				; JUMP TABLES (Two distinct tables!)
    35 				; =================================================================
    36 4009			TableY
    37 4009 20 40		    .word HandlerOpenY-1
    38 400B F1 40		    .word HandlerClose-1
    39 400D 9D 40		    .word HandlerGet-1
    40 400F D0 40		    .word HandlerPut-1
    41 4011 39 41		    .word HandlerStat-1
    42 4013 39 41		    .word HandlerSpec-1
    43
    44 4015			TableW
    45 4015 47 40		    .word HandlerOpenW-1
    46 4017 F1 40		    .word HandlerClose-1
    47 4019 9D 40		    .word HandlerGet-1
    48 401B D0 40		    .word HandlerPut-1
    49 401D 39 41		    .word HandlerStat-1
    50 401F 39 41		    .word HandlerSpec-1
